\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Stage~3 per-block codebook and projector norms (log scale).} Codebook mean $\ell _2$ norm grows monotonically with depth ($0.031 \to 0.414 \to 1.400 \to 2.888$), while the $f_{\text  {proj}}$ and $k_{\text  {up}}$ projector weight norms stay bounded across the same depth range --- consistent with the codebook absorbing the depth-driven scaling signal under the bidirectional commitment loss, rather than the projectors silently absorbing it as in Stages~1--2.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:norms}{{2}{5}{\textbf {Stage~3 per-block codebook and projector norms (log scale).} Codebook mean $\ell _2$ norm grows monotonically with depth ($0.031 \to 0.414 \to 1.400 \to 2.888$), while the $f_{\text {proj}}$ and $k_{\text {up}}$ projector weight norms stay bounded across the same depth range --- consistent with the codebook absorbing the depth-driven scaling signal under the bidirectional commitment loss, rather than the projectors silently absorbing it as in Stages~1--2}{figure.2}{}}
